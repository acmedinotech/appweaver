{
  "name": "@acmedinotech/appweaver",
  "version": "0.0.1-alpha",
  "description": "AppStich is an application orchestration framework powered by decorators. It allows modular, auto-wired application composition. Inspired by Apache Felix & the OSGi framework spec.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/library.d.ts",
  "browser": "./dist/appweaver.umd.min.js",
  "exports": {
    ".": {
      "types": "./dist/library.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "lint:types": "tsc --noEmit",
    "build": "rollup -c && tsc -p tsconfig.dts.json"
  },
  "keywords": [],
  "author": "",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mongodb": "^4.0.6",
    "@types/node": "^25.5.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jest": "^30.3.0",
    "mongodb": "^7.2.0",
    "rollup": "^4.55.1",
    "rollup-plugin-typescript2": "^0.37.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
